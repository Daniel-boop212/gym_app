<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GymApp.Views.ProgressPage"
    Title="Progreso">

    <VerticalStackLayout
        Padding="24"
        Spacing="20">

        <Label
            Text="Progreso"
            FontSize="32"
            FontAttributes="Bold" />

        <Label
            Text="Aquí podrás consultar tu evolución."
            FontSize="18" />

        <Border
            Padding="20"
            StrokeShape="RoundRectangle 12">

            <Label
                Text="Estadísticas y gráficas&#10;&#10;Próximamente"
                FontSize="18" />

        </Border>

    </VerticalStackLayout>

</ContentPage>