<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interface="clr-namespace:GymApp.Views.Interface"
    x:Class="GymApp.Views.ProfilePage"
    Shell.NavBarIsVisible="False"
    Title="Perfil">

    <ScrollView>
        <VerticalStackLayout Padding="22,24" Spacing="18">
            <interface:AppHeader
                Title="Tu perfil"
                Subtitle="Información personal y preferencias de entrenamiento." />

            <interface:AppSection>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Información personal" FontSize="21" FontAttributes="Bold" />
                    <interface:AppCard>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Nombre" FontSize="14" FontAttributes="Bold" />
                            <Entry x:Name="NameEntry" Placeholder="Tu nombre" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Edad" FontSize="14" FontAttributes="Bold" />
                                    <Entry x:Name="AgeEntry" Placeholder="Ej. 20" Keyboard="Numeric" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Altura (cm)" FontSize="14" FontAttributes="Bold" />
                                    <Entry x:Name="HeightEntry" Placeholder="Ej. 170" Keyboard="Numeric" />
                                </VerticalStackLayout>
                            </Grid>

                            <Label Text="Peso (kg)" FontSize="14" FontAttributes="Bold" />
                            <Entry x:Name="WeightEntry" Placeholder="Ej. 80" Keyboard="Numeric" />
                        </VerticalStackLayout>
                    </interface:AppCard>
                </VerticalStackLayout>
            </interface:AppSection>

            <interface:AppSection>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Objetivo" FontSize="21" FontAttributes="Bold" />
                    <interface:AppCard>
                        <Picker x:Name="GoalPicker" Title="Selecciona tu objetivo">
                            <Picker.Items>
                                <x:String>Ganar músculo</x:String>
                                <x:String>Perder grasa</x:String>
                                <x:String>Mantener peso</x:String>
                                <x:String>Mejorar condición física</x:String>
                            </Picker.Items>
                        </Picker>
                    </interface:AppCard>
                </VerticalStackLayout>
            </interface:AppSection>

            <interface:AppSection>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Información de salud" FontSize="21" FontAttributes="Bold" />
                    <interface:AppCard>
                        <VerticalStackLayout Spacing="12">
                            <Label
                                Text="Esta información es opcional y ayuda a tener en cuenta posibles limitaciones durante el entrenamiento."
                                FontSize="14"
                                TextColor="{StaticResource FitnessMutedText}" />

                            <Label Text="¿Tienes alguna condición médica que debamos tener en cuenta?" FontSize="14" FontAttributes="Bold" />
                            <Picker x:Name="MedicalConditionPicker" Title="Selecciona una opción">
                                <Picker.Items>
                                    <x:String>No</x:String>
                                    <x:String>Sí</x:String>
                                    <x:String>Prefiero no indicarlo</x:String>
                                </Picker.Items>
                            </Picker>

                            <Label Text="Condiciones o restricciones" FontSize="14" FontAttributes="Bold" />
                            <Editor
                                x:Name="MedicalConditionsEditor"
                                Placeholder="Información adicional (opcional)"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="84" />

                            <Label Text="¿Tienes alguna lesión actual?" FontSize="14" FontAttributes="Bold" />
                            <Picker x:Name="InjuryPicker" Title="Selecciona una opción">
                                <Picker.Items>
                                    <x:String>No</x:String>
                                    <x:String>Sí</x:String>
                                    <x:String>Prefiero no indicarlo</x:String>
                                </Picker.Items>
                            </Picker>

                            <Label Text="Lesiones o zonas que debemos tener en cuenta" FontSize="14" FontAttributes="Bold" />
                            <Editor
                                x:Name="InjuriesEditor"
                                Placeholder="Información adicional (opcional)"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="84" />

                            <Label Text="Ejercicios o movimientos que debes evitar" FontSize="14" FontAttributes="Bold" />
                            <Editor
                                x:Name="AvoidExercisesEditor"
                                Placeholder="Ej. movimientos que causen dolor o que te hayan indicado evitar"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="84" />

                            <Label
                                Text="La información de salud no sustituye la valoración de un profesional de la salud."
                                FontSize="12"
                                TextColor="{StaticResource FitnessMutedText}" />
                        </VerticalStackLayout>
                    </interface:AppCard>
                </VerticalStackLayout>
            </interface:AppSection>

            <interface:AppButton
                Text="Guardar cambios"
                Clicked="OnSaveClicked"
                Margin="0,4,0,20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
