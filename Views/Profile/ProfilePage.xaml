<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GymApp.Views.ProfilePage"
    Title="Perfil">

    <ScrollView>

        <VerticalStackLayout
            Padding="24"
            Spacing="18">

            <Label
                Text="Perfil"
                FontSize="32"
                FontAttributes="Bold" />

            <!-- Información personal -->

            <Border
                Padding="20"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Información personal"
                        FontSize="21"
                        FontAttributes="Bold" />

                    <Label
                        Text="Nombre"
                        FontSize="15" />

                    <Entry
                        x:Name="NameEntry"
                        Placeholder="Tu nombre" />

                    <Label
                        Text="Edad"
                        FontSize="15" />

                    <Entry
                        x:Name="AgeEntry"
                        Placeholder="Ej. 20"
                        Keyboard="Numeric" />

                    <Label
                        Text="Altura (cm)"
                        FontSize="15" />

                    <Entry
                        x:Name="HeightEntry"
                        Placeholder="Ej. 170"
                        Keyboard="Numeric" />

                    <Label
                        Text="Peso (kg)"
                        FontSize="15" />

                    <Entry
                        x:Name="WeightEntry"
                        Placeholder="Ej. 80"
                        Keyboard="Numeric" />

                </VerticalStackLayout>

            </Border>


            <!-- Objetivo -->

            <Border
                Padding="20"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Objetivo"
                        FontSize="21"
                        FontAttributes="Bold" />

                    <Picker
                        x:Name="GoalPicker"
                        Title="Selecciona tu objetivo">

                        <Picker.Items>

                            <x:String>Ganar músculo</x:String>
                            <x:String>Perder grasa</x:String>
                            <x:String>Mantener peso</x:String>
                            <x:String>Mejorar condición física</x:String>

                        </Picker.Items>

                    </Picker>

                </VerticalStackLayout>

            </Border>


            <!-- Información de salud -->

            <Border
                Padding="20"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Información de salud"
                        FontSize="21"
                        FontAttributes="Bold" />

                    <Label
                        Text="Esta información es opcional y puede utilizarse para tener en cuenta posibles limitaciones durante el entrenamiento."
                        FontSize="14" />

                    <Label
                        Text="¿Tienes alguna condición médica que debamos tener en cuenta?"
                        FontSize="15"
                        FontAttributes="Bold" />

                    <Picker
                        x:Name="MedicalConditionPicker"
                        Title="Selecciona una opción">

                        <Picker.Items>

                            <x:String>No</x:String>
                            <x:String>Sí</x:String>
                            <x:String>Prefiero no indicarlo</x:String>

                        </Picker.Items>

                    </Picker>

                    <Label
                        Text="Condiciones o restricciones"
                        FontSize="15" />

                    <Editor
                        x:Name="MedicalConditionsEditor"
                        Placeholder="Información adicional (opcional)"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="100" />

                    <Label
                        Text="¿Tienes alguna lesión actual?"
                        FontSize="15"
                        FontAttributes="Bold" />

                    <Picker
                        x:Name="InjuryPicker"
                        Title="Selecciona una opción">

                        <Picker.Items>

                            <x:String>No</x:String>
                            <x:String>Sí</x:String>
                            <x:String>Prefiero no indicarlo</x:String>

                        </Picker.Items>

                    </Picker>

                    <Label
                        Text="Lesiones o zonas que debemos tener en cuenta"
                        FontSize="15" />

                    <Editor
                        x:Name="InjuriesEditor"
                        Placeholder="Información adicional (opcional)"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="100" />

                    <Label
                        Text="Ejercicios o movimientos que debes evitar"
                        FontSize="15" />

                    <Editor
                        x:Name="AvoidExercisesEditor"
                        Placeholder="Ej. movimientos que causen dolor o que te hayan indicado evitar"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="100" />

                    <Label
                        Text="La información de salud no sustituye la valoración ni las recomendaciones de un médico u otro profesional de la salud."
                        FontSize="13" />

                </VerticalStackLayout>

            </Border>


            <Button
                Text="Guardar cambios"
                Clicked="OnSaveClicked"
                Margin="0,5,0,20" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>