<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="GymApp.Views.Interface.AppHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <VerticalStackLayout Spacing="4">
        <Label
            Style="{StaticResource AppHeaderTitleStyle}"
            Text="{Binding Title, Source={x:Reference Root}}" />
        <Label
            x:Name="SubtitleLabel"
            Style="{StaticResource AppHeaderSubtitleStyle}"
            IsVisible="False"
            Text="{Binding Subtitle, Source={x:Reference Root}}" />
    </VerticalStackLayout>
</ContentView>
