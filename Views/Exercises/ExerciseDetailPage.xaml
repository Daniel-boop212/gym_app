<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interface="clr-namespace:GymApp.Views.Interface"
    x:Class="GymApp.Views.ExerciseDetailPage"
    Shell.NavBarIsVisible="True"
    BackgroundColor="{StaticResource FitnessBackground}"
    Title="{Binding Name}">

    <ScrollView>
        <VerticalStackLayout Padding="22,24" Spacing="16">

            <interface:AppCard>
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{Binding Name}"
                        FontSize="29"
                        FontAttributes="Bold"
                        TextColor="{StaticResource FitnessText}" />
                    <Border
                        Padding="10,5"
                        BackgroundColor="{StaticResource FitnessTint}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 9"
                        HorizontalOptions="Start">
                        <Label
                            Text="{Binding MuscleGroup}"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="{StaticResource FitnessPrimary}" />
                    </Border>
                </VerticalStackLayout>
            </interface:AppCard>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <interface:AppCard>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="EQUIPO" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource FitnessMutedText}" />
                        <Label Text="{Binding Equipment}" FontSize="15" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </interface:AppCard>
                <interface:AppCard Grid.Column="1">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="DIFICULTAD" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource FitnessMutedText}" />
                        <Label Text="{Binding Difficulty}" FontSize="15" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </interface:AppCard>
                <interface:AppCard Grid.Row="1" Grid.ColumnSpan="2">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="TIPO DE EJERCICIO" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource FitnessMutedText}" />
                        <Label Text="{Binding Type}" FontSize="15" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </interface:AppCard>
            </Grid>

            <interface:AppSection>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Información" FontSize="21" FontAttributes="Bold" />
                    <interface:AppCard>
                        <Label Text="{Binding Description}" FontSize="16" LineHeight="1.2" />
                    </interface:AppCard>
                </VerticalStackLayout>
            </interface:AppSection>

            <interface:AppSection>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Músculos secundarios" FontSize="21" FontAttributes="Bold" />
                    <interface:AppCard>
                        <VerticalStackLayout
                            Spacing="8"
                            BindableLayout.ItemsSource="{Binding SecondaryMuscles}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding ., StringFormat='•  {0}'}" FontSize="15" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </interface:AppCard>
                </VerticalStackLayout>
            </interface:AppSection>

            <interface:AppSection>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Instrucciones" FontSize="21" FontAttributes="Bold" />
                    <interface:AppCard>
                        <VerticalStackLayout
                            Spacing="10"
                            BindableLayout.ItemsSource="{Binding Instructions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding ., StringFormat='•  {0}'}" FontSize="15" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </interface:AppCard>
                </VerticalStackLayout>
            </interface:AppSection>

            <interface:AppSection>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Consejos" FontSize="21" FontAttributes="Bold" />
                    <interface:AppCard>
                        <VerticalStackLayout
                            Spacing="10"
                            BindableLayout.ItemsSource="{Binding Tips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding ., StringFormat='•  {0}'}" FontSize="15" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </interface:AppCard>
                </VerticalStackLayout>
            </interface:AppSection>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
