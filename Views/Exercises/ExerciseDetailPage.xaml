<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GymApp.Views.ExerciseDetailPage">

    <ScrollView>

        <VerticalStackLayout Padding="24" Spacing="18">

            <Label
                Text="{Binding Name}"
                FontSize="32"
                FontAttributes="Bold" />

            <Label
                Text="{Binding MuscleGroup}"
                FontSize="20" />

            <BoxView
                HeightRequest="1"
                Margin="0,5" />

            <Label
                Text="Información"
                FontSize="24"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Description}"
                FontSize="17" />

            <Label
                Text="Equipamiento"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Equipment}"
                FontSize="17" />

            <Label
                Text="Dificultad"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Difficulty}"
                FontSize="17" />

            <Label
                Text="Tipo"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Type}"
                FontSize="17" />

            <Label
                Text="Músculos secundarios"
                FontSize="20"
                FontAttributes="Bold" />

            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding SecondaryMuscles}">

                <BindableLayout.ItemTemplate>

                    <DataTemplate>

                        <Label
                            Text="{Binding ., StringFormat='• {0}'}"
                            FontSize="17" />

                    </DataTemplate>

                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

            <Label
                Text="Instrucciones"
                FontSize="24"
                FontAttributes="Bold" />

            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding Instructions}">

                <BindableLayout.ItemTemplate>

                    <DataTemplate>

                        <Label
                            Text="{Binding ., StringFormat='• {0}'}"
                            FontSize="17" />

                    </DataTemplate>

                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

            <Label
                Text="Consejos"
                FontSize="24"
                FontAttributes="Bold" />

            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding Tips}">

                <BindableLayout.ItemTemplate>

                    <DataTemplate>

                        <Label
                            Text="{Binding ., StringFormat='• {0}'}"
                            FontSize="17" />

                    </DataTemplate>

                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>