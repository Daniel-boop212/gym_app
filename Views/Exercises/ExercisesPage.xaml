<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GymApp.Views.ExercisesPage"
    Title="Ejercicios">

    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*">

        <Label
            Text="Ejercicios"
            FontSize="30"
            FontAttributes="Bold" />

        <SearchBar
            x:Name="SearchBar"
            Grid.Row="1"
            Placeholder="Buscar ejercicio..."
            Margin="0,10,0,10"
            TextChanged="OnSearchTextChanged" />

        <Picker
            x:Name="MuscleGroupPicker"
            Grid.Row="2"
            Title="Filtrar por grupo muscular"
            Margin="0,0,0,10"
            SelectedIndexChanged="OnMuscleGroupChanged" />

        <CollectionView
            x:Name="ExercisesList"
            Grid.Row="3">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Padding="15"
                        Margin="0,5"
                        StrokeShape="RoundRectangle 10">

                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="OnExerciseTapped" />

                        </Border.GestureRecognizers>

                        <VerticalStackLayout>

                            <Label
                                Text="{Binding Name}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding MuscleGroup}"
                                FontSize="15" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>