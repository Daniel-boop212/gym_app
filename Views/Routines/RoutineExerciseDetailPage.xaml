<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GymApp.Views.RoutineExerciseDetailPage"
    Title="Editar ejercicio">

    <ScrollView>

        <VerticalStackLayout
            Padding="24"
            Spacing="18">

            <Label
                x:Name="ExerciseNameLabel"
                FontSize="30"
                FontAttributes="Bold" />

            <Label
                x:Name="MuscleGroupLabel"
                FontSize="17" />

            <BoxView
                HeightRequest="1"
                Margin="0,5" />

            <Label
                Text="Series"
                FontSize="16"
                FontAttributes="Bold" />

            <Entry
                x:Name="SetsEntry"
                Keyboard="Numeric"
                Placeholder="Ej. 3" />

            <Label
                Text="Repeticiones"
                FontSize="16"
                FontAttributes="Bold" />

            <Entry
                x:Name="RepsEntry"
                Keyboard="Numeric"
                Placeholder="Ej. 10" />

            <Label
                Text="Peso (kg)"
                FontSize="16"
                FontAttributes="Bold" />

            <Entry
                x:Name="WeightEntry"
                Keyboard="Numeric"
                Placeholder="Ej. 20" />

            <Label
                Text="Descanso (segundos)"
                FontSize="16"
                FontAttributes="Bold" />

            <Entry
                x:Name="RestEntry"
                Keyboard="Numeric"
                Placeholder="Ej. 60" />

            <Button
                Text="Guardar cambios"
                Clicked="OnSaveClicked"
                Margin="0,15,0,0" />

            <Button
                Text="Eliminar ejercicio"
                Clicked="OnDeleteClicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>