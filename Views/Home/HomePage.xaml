<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:interface="clr-namespace:GymApp.Views.Interface"
    x:Class="GymApp.Views.HomePage"
    Shell.NavBarIsVisible="False"
    Title="Inicio">

    <ScrollView>

        <VerticalStackLayout
            Padding="24"
            Spacing="20">

            <interface:AppHeader
                Title="Hola, Daniel 👋"
                Subtitle="¿Listo para entrenar?" />


            <interface:AppCard>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Entrenamiento de hoy"
                        FontSize="17"
                        FontAttributes="Bold" />

                    <Label
                        Text="Elige una rutina para comenzar tu próxima sesión."
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Label
                        Text="Cuando finalices un entrenamiento, tus datos aparecerán en Inicio y Progreso."
                        FontSize="15" />

                    <interface:AppButton
                        Text="Ver rutinas"
                        Clicked="OnRoutinesClicked" />

                </VerticalStackLayout>

            </interface:AppCard>


            <Label
                Text="Resumen"
                FontSize="23"
                FontAttributes="Bold" />


            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <interface:AppCard>

                    <VerticalStackLayout Spacing="5">

                        <Label
                        Text="{Binding CompletedWorkoutsText}"
                            FontSize="28"
                            FontAttributes="Bold" />

                        <Label
                            Text="Entrenamientos"
                            FontSize="14" />

                    </VerticalStackLayout>

                </interface:AppCard>

                <interface:AppCard
                    Grid.Column="1">

                    <VerticalStackLayout Spacing="5">

                        <Label
                        Text="{Binding TrainingTimeText}"
                            FontSize="28"
                            FontAttributes="Bold" />

                        <Label
                            Text="Minutos"
                            FontSize="14" />

                    </VerticalStackLayout>

                </interface:AppCard>

            </Grid>


            <Label
                Text="Actividad reciente"
                FontSize="23"
                FontAttributes="Bold"
                Margin="0,5,0,0" />


            <interface:AppCard>

                <VerticalStackLayout
                    Spacing="8"
                    HorizontalOptions="Center">

                    <Label
                        Text="{Binding LatestActivityTitle}"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="{Binding LatestActivityDescription}"
                        FontSize="14"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </interface:AppCard>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
